# --- Required ---
# PostgreSQL connection string (Supabase, Neon, RDS, or local).
DATABASE_URL="postgresql://vb:vb@localhost:5432/verdictboard?schema=public"
# Public base URL used in login emails and canonical links.
APP_URL="http://localhost:3000"
# 32+ random bytes; used to hash IPs for rate limiting and sign tokens. `openssl rand -hex 32`
APP_SECRET="change-me-to-a-long-random-string"
# Comma-separated emails that are granted ADMIN on first sign-in.
ADMIN_EMAILS="you@example.com"

# --- Email (magic-link sign-in) ---
# If unset in development, sign-in links are printed to the server console.
RESEND_API_KEY=""
EMAIL_FROM="VerdictBoard <login@yourdomain.org>"

# --- AI research assistant (optional) ---
# Without a key, the research desk and claim decomposer are disabled and the rest of the site works.
ANTHROPIC_API_KEY=""
# Defaults to claude-opus-5-5
ANTHROPIC_MODEL=""

# --- Editorial policy ---
# When "true", the person who drafted an item cannot be the one who publishes it.
REQUIRE_SECOND_REVIEWER="true"
# Minimum respondents in a subgroup before its breakdown is shown.
MIN_SUBGROUP_SIZE="30"

# --- Disclosure (shown on /about) ---
ORG_NAME=""
FUNDING_DISCLOSURE=""
# Staging only: print sign-in links to the log in a production build without an email provider.
EMAIL_LOG_LINKS=""
